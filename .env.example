# ============================================================================
# Switchyard: Open Agent Hackathon 2026 Configuration (.env.example)
# Copy to .env: cp .env.example .env
# SECURITY RULE: Never commit real API keys. Your NVIDIA API key goes inside
# Meterless Nightshift (Setup -> Providers -> NVIDIA), NOT in this file.
# ============================================================================

# --- Execution Mode ---
# Set SAMPLE_MODE=true to run cleanly without live Zetaris Docker or Nightshift
# (required by judging rubric so judges can run the full pipeline immediately).
# Set SAMPLE_MODE=false (or use --live) when Zetaris and Nightshift are running.
SAMPLE_MODE=true

# --- 01 DATA LAYER: Zetaris (Local Docker or Zetaris Cloud) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_USERNAME=your-sign-in-email-here
ZETARIS_PASSWORD=your-password-here

# --- 03 POWER LAYER: Meterless Nightshift & NVIDIA Nemotron ---
# Obtained from Meterless Nightshift -> Console (top right)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token-here
METERLESS_APP_NAME=switchyard-agent
METERLESS_ROUTING_MODE=nemotron-pinned

# Active NVIDIA Nemotron lanes configured in Meterless Nightshift (NIGHT -> LANES)
# Lane 1 (Fast worker: SQL generation, Scout Intent, initial reconciliation)
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Lane 2 (Deep worker: Conflict Critic, multi-source audit, Remediation Report)
NEMOTRON_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Default route / model used by smoke_test.py
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Aliases expected by the official Participant Setup Guide smoke_test.py (Page 24)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token-here
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Server Port ---
PORT=8050
